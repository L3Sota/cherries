#define name photo-prune-test
#define color red
#define glyph photoStack
#define version 18

#include 'actions/calendar'
#include 'actions/documents'
#include 'actions/math'
#include 'actions/photos'
#include 'actions/sharing'
#include 'actions/text'

// Keep LABEL in step with every Find Photos filter below: it names the export CSV that the prune guard checks.
const LABEL = "before-2025-01-01"
const PRUNE_RATIO = 0.1
const PRUNE_PERCENT = PRUNE_RATIO * 100
// Per-row cost grows with page size above 250 (1000: 36.3s, 500: 12.2s, 250: 5.2s, 100: 2.1s).
const CHUNK = 250
// Long runs die partway through a large library (about 32 pages in on the iOS 18 target), so a run stops after
// this many pages and says how to resume.
const PAGES_PER_RUN = 30
const OUT_DIR = "photo-prune-test"
const DATE_FORMAT = "yyyy-MM-dd'T'HH:mm:ssXXX"
const now = currentDate()
const startedAt = formatDate(now, "Custom", "yyyyMMdd'T'HHmmss")

@resume = 0
menu "photo-prune: {LABEL}" {
    item "Step 1: export CSV":
        @mode = "export"
    item "Step 1: resume export":
        @mode = "export"
        @resume = 1
    item "Step 2: Prune {PRUNE_PERCENT}%":
        @mode = "prune"
    item "Step 2: resume prune":
        @mode = "prune"
        @resume = 1
}

// Repeat with Each over photos is quadratic even with an empty body, and building columns from a whole
// ~4000-photo collection (or from ranges of one) dies, so photos are fetched by Find Photos in pages of CHUNK.
// Each page's columns come from property access on the page, and only the split text columns are looped over.

// Requires the L3Sota/cherri fork: stock Cherri can't pass a serialized filter or plist dates through rawAction.
// Values inside WFContentItemFilter are literal; Cherri constants and variables aren't resolved there, so the
// page cursor is referenced as the named variable "cursor".
const photos = rawAction("is.workflow.actions.filter.photos", {
    "WFContentItemFilter": {
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFActionParameterFilterTemplates": [
                {
                    "Operator": 0,
                    "Property": "Date Taken",
                    "Removable": true,
                    "Values": {
                        "Date": {"$date": "2025-01-01T00:00:00+09:00"},
                        "Unit": 4
                    }
                }
            ],
            "WFContentPredicateBoundedDate": false
        },
        "WFSerializationType": "WFContentPredicateTableTemplate"
    }
})
const total = count(photos)

@pageNo: number
@pageNo = 1
@cursor = date("1900-01-01")
// A fresh folder per run, so a shorter re-export can't leave stale pages behind.
@folderName = "favorites_{LABEL}_{startedAt}"
@resumeStep = "Step 1: resume export"
if @mode == "prune" {
    @folderName = "pruned_{LABEL}_{startedAt}"
    @resumeStep = "Step 2: resume prune"
}

if @resume == 1 {
    // progress.txt is written once a page is finished, so after a crash it names the page that was cut short,
    // which is redone and overwritten.
    const resumeFolder = prompt("Folder to continue, as named in Shortcuts/{OUT_DIR}")
    const resumeDay = prompt("First day to continue from: the day in the stop notification, or after a crash, in the folder's progress.txt.", "Date")
    const resumePage = prompt("Page number to save it as, from the same place.", "Number")
    const resumeDayText = formatDate(resumeDay, "Custom", "yyyy-MM-dd")
    const resumeDayStart = date(resumeDayText)
    @folderName = resumeFolder
    @cursor = resumeDayStart
    @pageNo = resumePage
}
@runStart = @cursor
@outDir = "{OUT_DIR}/{@folderName}"

if @mode == "prune" {
    if @resume == 0 {
        alert("Select all page-*.csv files in the latest export folder to check basic export consistency (total photo count). They are usually in iCloud Drive/Shortcuts/{OUT_DIR}/favorites_{LABEL}_<timestamp>/.")
        // Rows are counted from the saved pages: a single saved count derived from every photo carries every
        // photo's provenance, and saving it dies like the run-wide CSV did.
        const pageFiles = selectFile(true)
        @exportedRows: number
        for pageFile in pageFiles {
            const pageLines = count(@pageFile, "Lines")
            const pageRows = pageLines - 1
            @exportedRows = @exportedRows + pageRows
        }
        // Not just "fewer rows": an export from before photos were deleted or restored has more rows than match now.
        if total != @exportedRows {
            alert("{total} photos match, but the selected pages have {@exportedRows} rows. Select every page of an export made since the library last changed, or re-run the export.", "photo-prune")
            stop()
        }

        const totalPrunable = total * PRUNE_RATIO
        const pruneLimit = round(totalPrunable)
        if pruneLimit == 0 {
            alert("{PRUNE_PERCENT}% of {total} photos rounds to 0. Nothing to delete.", "photo-prune")
            stop()
        }
        confirm("Delete {PRUNE_PERCENT}% of each day's photos, about {pruneLimit} of {total}? Each page's list is saved to {@outDir} before it is deleted, and each deletion is given time to finish, so this takes a while.", "photo-prune")
    } else {
        const resumeFromText = formatDate(@cursor, "Custom", "yyyy-MM-dd")
        confirm("Delete {PRUNE_PERCENT}% of each day's photos from {resumeFromText}, listed in {@outDir}?", "photo-prune")
    }
}

@pageLimit = CHUNK
@saved: number
@done: number
@done = 0
repeat p for PAGES_PER_RUN {
    // Shortcuts has no break, so pages after the last one are skipped instead.
    if @done == 0 {
        // Find Photos has a limit but no offset, so pages are keyed on Date Taken. iOS 18 has no "on or after"
        // filter, but its "is in the range" includes the start day and stops before the end day, comparing whole
        // days. So each page covers whole days: the probe finds where CHUNK photos end, and the page stops before
        // that day, which the next page starts on.
        @windowStart = @cursor
        const probe = rawAction("is.workflow.actions.filter.photos", {
            "WFContentItemFilter": {
                "Value": {
                    "WFActionParameterFilterPrefix": 1,
                    "WFActionParameterFilterTemplates": [
                        {
                            "Operator": 1003,
                            "Property": "Date Taken",
                            "Removable": true,
                            "Values": {
                                "Date": {
                                    "Value": {"Type": "Variable", "VariableName": "cursor"},
                                    "WFSerializationType": "WFTextTokenAttachment"
                                },
                                "AnotherDate": {"$date": "2025-01-01T00:00:00+09:00"},
                                "Unit": 4
                            }
                        }
                    ],
                    "WFContentPredicateBoundedDate": false
                },
                "WFSerializationType": "WFContentPredicateTableTemplate"
            },
            "WFContentItemSortOrder": "Oldest First",
            "WFContentItemSortProperty": "Date Taken",
            "WFContentItemLimitEnabled": true,
            "WFContentItemLimitNumber": "${pageLimit}"
        })
        const probeSize = count(probe)
        if probeSize < CHUNK {
            @page = probe
            @done = 1
        } else {
            const firstPhoto = getFirstItem(probe)
            const lastPhoto = getLastItem(probe)
            const firstDay = formatDate(firstPhoto['Date Taken'], "Custom", "yyyy-MM-dd")
            const lastDay = formatDate(lastPhoto['Date Taken'], "Custom", "yyyy-MM-dd")
            // Bounds sit at midnight, so pages don't depend on whether the range compares days or timestamps.
            const lastDayStart = date(lastDay)
            @pageEnd = lastDayStart
            // A single day with CHUNK or more photos becomes one oversized page, or paging would never move on.
            if firstDay == lastDay {
                const nextDay = adjustDate(lastDayStart, "Add", qty(1, "days"))
                @pageEnd = nextDay
            }
            // The limit is only there because Find Photos with neither a sort nor a limit errors after a deletion.
            const dayPage = rawAction("is.workflow.actions.filter.photos", {
                "WFContentItemFilter": {
                    "Value": {
                        "WFActionParameterFilterPrefix": 1,
                        "WFActionParameterFilterTemplates": [
                            {
                                "Operator": 1003,
                                "Property": "Date Taken",
                                "Removable": true,
                                "Values": {
                                    "Date": {
                                        "Value": {"Type": "Variable", "VariableName": "cursor"},
                                        "WFSerializationType": "WFTextTokenAttachment"
                                    },
                                    "AnotherDate": {
                                        "Value": {"Type": "Variable", "VariableName": "pageEnd"},
                                        "WFSerializationType": "WFTextTokenAttachment"
                                    },
                                    "Unit": 4
                                }
                            }
                        ],
                        "WFContentPredicateBoundedDate": false
                    },
                    "WFSerializationType": "WFContentPredicateTableTemplate"
                },
                "WFContentItemSortOrder": "Oldest First",
                "WFContentItemSortProperty": "Date Taken",
                "WFContentItemLimitEnabled": true,
                "WFContentItemLimitNumber": 100000
            })
            @page = dayPage
            @cursor = @pageEnd
        }

        @take = 1
        if @mode == "prune" {
            // Each page's share is drawn from its own days, which no other page touches, so nothing is drawn twice
            // and nothing depends on reading the library after a deletion. Counts read back during a run were stale,
            // and the deletion of a page lands well after Delete Photos returns.
            const windowSize = count(@page)
            const windowShare = windowSize * PRUNE_RATIO
            const windowPrune = round(windowShare)
            @pruneCount = windowPrune
            if windowPrune == 0 {
                @take = 0
            } else {
                if @done == 1 {
                    const lastPick = rawAction("is.workflow.actions.filter.photos", {
                        "WFContentItemFilter": {
                            "Value": {
                                "WFActionParameterFilterPrefix": 1,
                                "WFActionParameterFilterTemplates": [
                                    {
                                        "Operator": 1003,
                                        "Property": "Date Taken",
                                        "Removable": true,
                                        "Values": {
                                            "Date": {
                                                "Value": {"Type": "Variable", "VariableName": "windowStart"},
                                                "WFSerializationType": "WFTextTokenAttachment"
                                            },
                                            "AnotherDate": {"$date": "2025-01-01T00:00:00+09:00"},
                                            "Unit": 4
                                        }
                                    }
                                ],
                                "WFContentPredicateBoundedDate": false
                            },
                            "WFSerializationType": "WFContentPredicateTableTemplate"
                        },
                        "WFContentItemSortProperty": "Random",
                        "WFContentItemLimitEnabled": true,
                        "WFContentItemLimitNumber": "${pruneCount}"
                    })
                    @page = lastPick
                } else {
                    const windowPick = rawAction("is.workflow.actions.filter.photos", {
                        "WFContentItemFilter": {
                            "Value": {
                                "WFActionParameterFilterPrefix": 1,
                                "WFActionParameterFilterTemplates": [
                                    {
                                        "Operator": 1003,
                                        "Property": "Date Taken",
                                        "Removable": true,
                                        "Values": {
                                            "Date": {
                                                "Value": {"Type": "Variable", "VariableName": "windowStart"},
                                                "WFSerializationType": "WFTextTokenAttachment"
                                            },
                                            "AnotherDate": {
                                                "Value": {"Type": "Variable", "VariableName": "pageEnd"},
                                                "WFSerializationType": "WFTextTokenAttachment"
                                            },
                                            "Unit": 4
                                        }
                                    }
                                ],
                                "WFContentPredicateBoundedDate": false
                            },
                            "WFSerializationType": "WFContentPredicateTableTemplate"
                        },
                        "WFContentItemSortProperty": "Random",
                        "WFContentItemLimitEnabled": true,
                        "WFContentItemLimitNumber": "${pruneCount}"
                    })
                    @page = windowPick
                }
            }
        }

        if @take == 1 {
            const pageSize = count(@page)
            if pageSize > 0 {
                const names = splitText("{@page['Name']}")
                const extensions = splitText("{@page['File Extension']}")
                const isoDates = formatDate(@page['Date Taken'], "Custom", DATE_FORMAT)
                const dates = splitText("{isoDates}")
                const bytes = splitText("{@page['File Size'].number}")
                const rowCount = count(names)
                // A named index, since RepeatIndex inside this nested loop would be the outer page index.
                const rows = repeat r for rowCount {
                    const name = getListItem(names, @r)
                    const extension = getListItem(extensions, @r)
                    const date = getListItem(dates, @r)
                    const byte = getListItem(bytes, @r)
                    const row = "{name},{extension},{date},{byte}"
                }
                const joined = joinText(rows)
                // One file per page: a single run-wide CSV carries every photo's provenance and dies when saved.
                // In prune mode this also lands before the page is deleted, so the lists cover every deleted photo.
                const pageCSV = "name,extension,date taken,bytes\n{joined}"
                saveFile("{@outDir}/page-{@pageNo}.csv", pageCSV, true)
                @saved = @saved + pageSize

                if @mode == "prune" {
                    deletePhotos(@page)
                    // The next deletion or the end of the run cuts a deletion short, and it can't be checked from here,
                    // so wait a generous time: pages were seen deleting at roughly 20 photos a second.
                    const deleteWaitRaw = pageSize / 5
                    const deleteWait = deleteWaitRaw + 10
                    wait(deleteWait)
                }
            }
        }
        @pageNo = @pageNo + 1
        const progressDay = formatDate(@cursor, "Custom", "yyyy-MM-dd")
        const progress = "folder: {@folderName}\nday: {progressDay}\npage: {@pageNo}"
        saveFile("{@outDir}/progress.txt", progress, true)
    }
}

if @done == 0 {
    // The cursor is the day the next page starts on, and every saved page is complete.
    const resumeFrom = formatDate(@cursor, "Custom", "yyyy-MM-dd")
    const resumeDetails = "folder: {@folderName}\nday: {resumeFrom}\npage: {@pageNo}"
    // The menu is gone once dismissed, so the details also stay in Notification Center.
    showNotification("Saved {@saved} rows in {PAGES_PER_RUN} pages. To continue, choose {@resumeStep} with\n{resumeDetails}", "photo-prune")
    // Set Clipboard fails on text derived from photos, so the details open in Quick Look to copy from there.
    menu "Saved {@saved} rows in {PAGES_PER_RUN} pages to {@outDir}. To continue, choose \"{@resumeStep}\" with\n{resumeDetails}" {
        item "Show resume details to copy":
            quicklook(resumeDetails)
        item "Done":
            nothing()
    }
    stop()
}

if @mode == "export" {
    // Counted from this run's first day, so a resumed run checks only the pages it saved.
    const runPhotos = rawAction("is.workflow.actions.filter.photos", {
        "WFContentItemFilter": {
            "Value": {
                "WFActionParameterFilterPrefix": 1,
                "WFActionParameterFilterTemplates": [
                    {
                        "Operator": 1003,
                        "Property": "Date Taken",
                        "Removable": true,
                        "Values": {
                            "Date": {
                                "Value": {"Type": "Variable", "VariableName": "runStart"},
                                "WFSerializationType": "WFTextTokenAttachment"
                            },
                            "AnotherDate": {"$date": "2025-01-01T00:00:00+09:00"},
                            "Unit": 4
                        }
                    }
                ],
                "WFContentPredicateBoundedDate": false
            },
            "WFSerializationType": "WFContentPredicateTableTemplate"
        }
    })
    const runTotal = count(runPhotos)
    if @saved != runTotal {
        alert("Saved {@saved} rows to {@outDir}, but {runTotal} photos match from this run's first day. Pages may have overlapped or missed a day, so check the export before pruning.", "photo-prune")
        stop()
    }
    const finishedAt = currentDate()
    const exportedAt = formatTime(finishedAt, "Medium")
    showNotification("Exported {@saved} rows to {@outDir} at {exportedAt}. Select every page in the folder when pruning.", "photo-prune")
}

if @mode == "prune" {
    // Not checked against a count here, since counts read back during a run were stale.
    showNotification("Deleted {@saved} photos this run, listed in {@outDir}. Re-export to confirm the count, then empty Albums › Recently Deleted to actually free the space.", "photo-prune")
}
