#define name photo-prune
#define color red
#define glyph photoStack

#include 'actions/calendar'
#include 'actions/documents'
#include 'actions/math'
#include 'actions/photos'
#include 'actions/text'

// Keep LABEL in step with both Find Photos filters below: it names the export CSV that the prune guard checks.
const LABEL = "pre2024_before-2025-01-01"
const PRUNE_RATIO = 0.5
const PRUNE_PERCENT = PRUNE_RATIO * 100
const OUT_DIR = "photo-prune"
const DATE_FORMAT = "yyyy-MM-dd'T'HH:mm:ssXXX"
const now = currentDate()
const startedAt = formatDate(now, "Custom", "yyyyMMdd'T'HHmmss")

menu "photo-prune: {LABEL}" {
    item "Step 1: export CSV":
        @mode = "export"
    item "Step 2: Prune {PRUNE_PERCENT}%":
        @mode = "prune"
}

// Repeat with Each over photos is quadratic even with an empty body, so everything here works on whole
// collections: property access and Format Date on the collection give newline-separated columns, and only
// the split text columns are looped over.

// Requires the L3Sota/cherri fork: stock Cherri can't pass a serialized filter or plist dates through rawAction.
// Values inside WFContentItemFilter are literal; Cherri constants and variables aren't resolved there.
const photos = rawAction("is.workflow.actions.filter.photos", {
    "WFContentItemFilter": {
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFActionParameterFilterTemplates": [
                {
                    "Operator": 0,
                    "Property": "Date Taken",
                    "Removable": true,
                    "Values": {
                        "Date": {"$date": "2025-01-01T00:00:00+09:00"},
                        "Unit": 4
                    }
                },
                {
                    "Operator": 4,
                    "Property": "Album",
                    "Removable": true,
                    "Values": {
                        "Enumeration": {
                            "Value": "pre2024",
                            "WFSerializationType": "WFStringSubstitutableState"
                        },
                        "Unit": 4
                    }
                }
            ],
            "WFContentPredicateBoundedDate": false
        },
        "WFSerializationType": "WFContentPredicateTableTemplate"
    },
    "WFContentItemSortOrder": "Oldest First",
    "WFContentItemSortProperty": "Date Taken"
})
const total = count(photos)

if @mode == "export" {
    @exportPhotos = photos
    const names = splitText("{@exportPhotos['Name']}")
    const extensions = splitText("{@exportPhotos['File Extension']}")
    const isoDates = formatDate(@exportPhotos['Date Taken'], "Custom", DATE_FORMAT)
    const dates = splitText("{isoDates}")
    const sizes = splitText("{@exportPhotos['File Size']}")
    const bytes = splitText("{@exportPhotos['File Size'].number}")
    const rows = for name in names {
        const extension = getListItem(extensions, RepeatIndex)
        const date = getListItem(dates, RepeatIndex)
        const size = getListItem(sizes, RepeatIndex)
        const byte = getListItem(bytes, RepeatIndex)
        const row = "{@name},{extension},{date},{size},{byte}"
    }
    const exportRowCount = count(rows)
    const joined = joinText(rows)
    const exportCSV = "name,extension,date taken,size,bytes\n{joined}"
    saveFile("{OUT_DIR}/favorites_{LABEL}.csv", exportCSV, true)
    const finishedAt = currentDate()
    const exportedAt = formatTime(finishedAt, "Medium")
    showNotification("Exported {exportRowCount} rows to {OUT_DIR}/favorites_{LABEL}.csv at {exportedAt}", "photo-prune")
}

if @mode == "prune" {
    alert("Choose the export file to check basic export consistency (total photo count). File is usually at iCloud Drive/Shortcuts/{OUT_DIR}/favorites_{LABEL}.csv.")
    const exported = selectFile()
    const exportedLines = count(exported, "Lines")
    const exportedRows = exportedLines - 1
    if total > exportedRows {
        alert("{total} photos match, but {exported['Name']} has only {exportedRows} rows. Re-run the export first.", "photo-prune")
        stop()
    }

    const totalPrunable = total * PRUNE_RATIO
    const pruneLimit = round(totalPrunable)
    if pruneLimit == 0 {
        alert("{PRUNE_PERCENT}% of {total} photos rounds to 0. Nothing to delete.", "photo-prune")
        stop()
    }

    // Same filter as above, but randomly sorted and limited, so the selection itself is the random N% sample.
    const pruned = rawAction("is.workflow.actions.filter.photos", {
        "WFContentItemFilter": {
            "Value": {
                "WFActionParameterFilterPrefix": 1,
                "WFActionParameterFilterTemplates": [
                    {
                        "Operator": 0,
                        "Property": "Date Taken",
                        "Removable": true,
                        "Values": {
                            "Date": {"$date": "2025-01-01T00:00:00+09:00"},
                            "Unit": 4
                        }
                    },
                    {
                        "Operator": 4,
                        "Property": "Album",
                        "Removable": true,
                        "Values": {
                            "Enumeration": {
                                "Value": "pre2024",
                                "WFSerializationType": "WFStringSubstitutableState"
                            },
                            "Unit": 4
                        }
                    }
                ],
                "WFContentPredicateBoundedDate": false
            },
            "WFSerializationType": "WFContentPredicateTableTemplate"
        },
        "WFContentItemSortProperty": "Random",
        "WFContentItemLimitEnabled": true,
        "WFContentItemLimitNumber": "${pruneLimit}"
    })
    const pruneCount = count(pruned)

    const pNames = splitText("{pruned['Name']}")
    const pExtensions = splitText("{pruned['File Extension']}")
    const pIsoDates = formatDate(pruned['Date Taken'], "Custom", DATE_FORMAT)
    const pDates = splitText("{pIsoDates}")
    const pSizes = splitText("{pruned['File Size']}")
    const pBytes = splitText("{pruned['File Size'].number}")
    const pRows = for name in pNames {
        const pExtension = getListItem(pExtensions, RepeatIndex)
        const pDate = getListItem(pDates, RepeatIndex)
        const pSize = getListItem(pSizes, RepeatIndex)
        const pByte = getListItem(pBytes, RepeatIndex)
        const pRow = "{@name},{pExtension},{pDate},{pSize},{pByte}"
    }
    const pExportRowCount = count(pRows)
    const pJoined = joinText(pRows)
    const prunedCSV = "name,extension,date taken,size,bytes\n{pJoined}"
    saveFile("{OUT_DIR}/pruned_{LABEL}_{startedAt}.csv", prunedCSV, true)

    confirm("Delete {pruneCount} of {total} photos ({PRUNE_PERCENT}% target)? The list was saved to {OUT_DIR}/pruned_{LABEL}_{startedAt}.csv.", "photo-prune")
    deletePhotos(pruned)
    alert("Deleted {pruneCount} photos. Empty Albums › Recently Deleted to actually free the space.", "photo-prune")
}
