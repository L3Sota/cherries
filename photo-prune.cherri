#define name photo-prune
#define color red
#define glyph photoStack

#include 'actions/calendar'
#include 'actions/documents'
#include 'actions/photos'
#include 'actions/text'

// Keep LABEL in step with the Find Photos filter below: it names the export CSV that the prune guard checks.
const LABEL = "pre2024_before-2025-01-01"
const PRUNE_PERCENT = 50
const LIMIT = 0
const OUT_DIR = "photo-prune"

const startedAt = currentDate()
const stamp = formatDate(startedAt, "Custom", "yyyyMMdd'T'HHmmss")

menu "photo-prune: {LABEL}" {
    item "Export CSV only":
        @mode = "export"
    item "Prune {PRUNE_PERCENT}% only":
        @mode = "prune"
    item "Export, then prune {PRUNE_PERCENT}%":
        @mode = "both"
}

// Requires the L3Sota/cherri fork: stock Cherri can't pass a serialized filter or plist dates through rawAction.
// Values here are literal; Cherri constants and variables aren't resolved inside this block.
@photos = rawAction("is.workflow.actions.filter.photos", {
    "WFContentItemFilter": {
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFActionParameterFilterTemplates": [
                {
                    "Operator": 0,
                    "Property": "Date Taken",
                    "Removable": true,
                    "Values": {
                        "Date": {"$date": "2025-01-01T00:00:00+09:00"},
                        "Unit": 4
                    }
                },
                {
                    "Operator": 4,
                    "Property": "Album",
                    "Removable": true,
                    "Values": {
                        "Enumeration": {
                            "Value": "pre2024",
                            "WFSerializationType": "WFStringSubstitutableState"
                        },
                        "Unit": 4
                    }
                }
            ],
            "WFContentPredicateBoundedDate": false
        },
        "WFSerializationType": "WFContentPredicateTableTemplate"
    },
    "WFContentItemSortOrder": "Oldest First",
    "WFContentItemSortProperty": "Date Taken"
})
if LIMIT > 0 {
    @photos = getListItems(@photos, 1, LIMIT)
}
const total = count(@photos)

if @mode != "prune" {
    const rows = for photo in @photos {
        const iso = formatDate(@photo['Date Taken'], "Custom", "yyyy-MM-dd'T'HH:mm:ssXXX")
        const row = "{@photo['Name']},{iso},{@photo['File Size'].number}"
    }
    const joined = joinText(rows)
    const exportCSV = "name,date,size\n{joined}"
    saveFile("{OUT_DIR}/favorites_{LABEL}.csv", exportCSV, true)
    const finishedAt = currentDate()
    const exportedAt = formatTime(finishedAt, "Medium")
    showNotification("Exported {total} rows to {OUT_DIR}/favorites_{LABEL}.csv at {exportedAt}", "photo-prune")
}

if @mode != "export" {
    // Prune repeatedly is allowed, so the current set may shrink, but must never exceed what was exported.
    const exported = getFile("{OUT_DIR}/favorites_{LABEL}.csv")
    const exportedLines = count(exported, "Lines")
    @exportedRows = exportedLines - 1
    if total > @exportedRows {
        alert("{total} photos match, but favorites_{LABEL}.csv has only {@exportedRows} rows. Re-run the export first.", "photo-prune")
        stop()
    }

    @victims: array
    @victimRows: array
    for photo in @photos {
        const roll = randomNumber(1, 100)
        if roll <= PRUNE_PERCENT {
            @victims += @photo
            const victimISO = formatDate(@photo['Date Taken'], "Custom", "yyyy-MM-dd'T'HH:mm:ssXXX")
            @victimRows += "{@photo['Name']},{victimISO},{@photo['File Size'].number}"
        }
    }
    const victimCount = count(@victims)
    if victimCount == 0 {
        alert("No photos were selected out of {total}. Nothing to delete.", "photo-prune")
        stop()
    }
    const prunedJoined = joinText(@victimRows)
    const prunedCSV = "name,date,size\n{prunedJoined}"
    saveFile("{OUT_DIR}/pruned_{LABEL}_{stamp}.csv", prunedCSV, true)

    confirm("Delete {victimCount} of {total} photos ({PRUNE_PERCENT}% target)? The list was saved to {OUT_DIR}/pruned_{LABEL}_{stamp}.csv.", "photo-prune")
    deletePhotos(@victims)
    alert("Deleted {victimCount} photos. Empty Albums › Recently Deleted to actually free the space.", "photo-prune")
}
